# --- per-user data (never shared) --------------------------------------------
/data/collection.json
/data/collection.json.bak*
/data/history.jsonl
# your own regional-rule observations. Unlike the files above this is not
# personal - regionals are the same for every player - so it is safe to share if
# you ever want to pool observations with other people to grow the sample.
/data/regional_history.jsonl
# FFXIV Collect account exports - the filename carries your character name and
# world, and the contents are your account's collection
/reference/ffxiv_collect_export*.json
/data/.review_cache.json
/notes.txt

# --- scrape inputs / bulky wiki mirrors -------------------------------------
# Not needed to run or build. cards.json / npcs.json are committed already;
# re-save these pages from the wiki only when you need `tt-cli data` / `scrape`.
# The card-icon dir and the "Cards @ ARR" art + html ARE kept - the GUI serves them.
/reference/NPCs/
/reference/Triple Triad Cards*.html
/reference/Triple Triad - Final*.html
/reference/Triple Triad NPCs*.html
/reference/Triple Triad - Final*_files/
/reference/Triple Triad NPCs*_files/
/reference/*FFXIV Collect*.html
/reference/*FFXIV Collect*_files/
/reference/*.webp
# third-party source archives kept for reference only (re-downloadable)
/reference/FFTriadBuddy*.zip

# --- build output ----------------------------------------------------------
/build/
/dist/
*.spec.bak

# --- python -------------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/
